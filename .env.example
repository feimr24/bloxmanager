# Kunci enkripsi kredensial akun Roblox (AES-256-GCM)
BLOX_SECRET=ganti-dengan-string-acak-panjang

# Pengiriman email verifikasi & reset password via Resend
RESEND_API_KEY=
MAIL_FROM="BLOX MANAGER <onboarding@resend.dev>"

# URL publik aplikasi untuk tautan di email
APP_URL=http://localhost:3000

# Neon PostgreSQL (kosong = fallback ke data/blox.json lokal)
# BLOX_DATABASE_URL (Secret app-specific) diutamakan dari DATABASE_URL.
# Gunakan pooled connection string; jangan commit nilai rahasia.
BLOX_DATABASE_URL=
DATABASE_URL=
